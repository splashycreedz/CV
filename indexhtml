  </main>
  <footer>© 2026 Cirdei David-Andrei · CV Online</footer>
  <script>
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('visible');
      entry.target.querySelectorAll('.fill').forEach(fill => { fill.style.width = fill.dataset.width; fill.style.setProperty('--print-width', fill.dataset.width); });
      observer.unobserve(entry.target);
    }), { threshold: .12 });
    document.querySelectorAll('.reveal').forEach(element => observer.observe(element));

    const words = ['dedicat', 'responsabil', 'adaptabil', 'orientat spre rezultate'];
    const typed = document.getElementById('typed');
    let wordIndex = 0, characterIndex = 0, deleting = false;
    function type() {
      const word = words[wordIndex];
      typed.textContent = deleting ? word.slice(0, characterIndex--) : word.slice(0, characterIndex++);
      let delay = deleting ? 45 : 85;
      if (!deleting && characterIndex > word.length) { deleting = true; delay = 1200; }
      if (deleting && characterIndex < 0) { deleting = false; wordIndex = (wordIndex + 1) % words.length; characterIndex = 0; delay = 350; }
      window.setTimeout(type, delay);
    }
    type();

  </script>
</body>
</html>
