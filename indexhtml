      <div class="grid">
        <article class="card"><h3>Digital &amp; Office</h3><div class="skill"><div class="skill-top"><span>Google Sheets</span><span>85%</span></div><div class="bar"><div class="fill" data-width="85%"></div></div></div><div class="skill"><div class="skill-top"><span>Microsoft Excel</span><span>85%</span></div><div class="bar"><div class="fill" data-width="85%"></div></div></div><div class="skill"><div class="skill-top"><span>Google Docs / Word</span><span>80%</span></div><div class="bar"><div class="fill" data-width="80%"></div></div></div><div class="skill"><div class="skill-top"><span>Data entry &amp; organizare date</span><span>70%</span></div><div class="bar"><div class="fill" data-width="70%"></div></div></div><div class="skill"><div class="skill-top"><span>Gestionare fișiere și foldere</span><span>80%</span></div><div class="bar"><div class="fill" data-width="80%"></div></div></div><div class="skill"><div class="skill-top"><span>E-mail profesional și comunicare online</span><span>80%</span></div><div class="bar"><div class="fill" data-width="80%"></div></div></div></article>
