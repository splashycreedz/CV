<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cîrdei David-Andrei — CV</title>
  <style>
    :root {
      --bg: #19211f;
      --bg2: #111715;
      --text: #f1eee7;
      --muted: #b5bcb4;
      --accent: #a8c3ad;
      --accent2: #d0a66d;
      --line: rgba(236,232,221,.14);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-width: 320px;
      overflow-x: hidden;
      color: var(--text);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 13% 12%, rgba(168,195,173,.10), transparent 28%),
        radial-gradient(circle at 88% 84%, rgba(208,166,109,.07), transparent 30%),
        linear-gradient(145deg, var(--bg), var(--bg2));
    }

    nav {
      position: fixed;
      z-index: 20;
      top: 18px;
      left: 50%;
      display: flex;
      justify-content: center;
      gap: 0;
      width: min(1040px, calc(100% - 48px));
      padding: 7px;
      transform: translateX(-50%);
      border: 1px solid var(--line);
      border-radius: 999px;
      background: rgba(20,28,25,.76);
      backdrop-filter: blur(18px);
    }
    nav a {
      flex: 1 1 0;
      padding: 11px 15px;
      border-radius: 999px;
      color: var(--muted);
      font-size: 15px;
      text-align: center;
      text-decoration: none;
      transition: .25s;
    }
    nav a:hover { color: var(--text); background: rgba(255,255,255,.08); }

    .wrap {
      width: min(1040px, calc(100% - 48px));
      margin-inline: auto;
    }
    .hero {
      display: grid;
      min-height: min(92vh, 900px);
      padding: 132px 0 88px;
      place-items: center;
    }
    .hero-inner { max-width: 820px; text-align: center; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 13px;
      border: 1px solid rgba(98,217,255,.2);
      border-radius: 999px;
      background: rgba(98,217,255,.06);
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .dot {
      width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
      box-shadow: 0 0 18px var(--accent); animation: pulse 1.8s infinite;
    }
    h1 {
      margin: 22px 0 17px;
      color: var(--text);
      font-size: clamp(46px, 7vw, 82px);
      letter-spacing: -.055em;
      line-height: .96;
    }
    .role {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: .42em;
      min-height: 1.7em;
      margin: 0;
      color: #deded7;
      font-size: clamp(19px, 2.2vw, 24px);
      line-height: 1.4;
    }
    .role-static { white-space: nowrap; }
    .typing-wrap {
      display: inline-flex;
      align-items: baseline;
      min-width: 25ch;
      color: var(--accent);
      text-align: left;
    }
    .typed { white-space: nowrap; }
    .cursor {
      display: inline-block;
      width: 2px;
      height: .95em;
      margin-left: 3px;
      background: var(--accent);
      animation: blink .8s infinite;
    }
    .intro {
      max-width: 61ch;
      margin: 24px auto 0;
      color: var(--muted);
      font-size: 17px;
      line-height: 1.75;
      text-wrap: balance;
    }
    .actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 30px;
    }
    .btn {
      padding: 13px 20px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: rgba(255,255,255,.055);
      color: var(--text);
      text-decoration: none;
      transition: .25s;
    }
    .btn:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(0,0,0,.22); }
    .btn.primary { border: 0; background: var(--accent2); color: #1b1b18; font-weight: 800; }

    main { padding-bottom: 38px; }
    section { padding: 66px 0; }
    .section-head {
      display: grid;
      gap: 10px;
      max-width: 640px;
      margin-bottom: 28px;
    }
    .section-head h2 { margin: 0; font-size: clamp(29px, 3vw, 36px); letter-spacing: -.035em; }
    .section-head p {
      max-width: 52ch;
      margin: 0;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.65;
      text-wrap: pretty;
    }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
    .qualities-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .card {
      padding: 28px;
      border: 1px solid var(--line);
      border-radius: 24px;
      background: rgba(31,42,38,.72);
      box-shadow: 0 20px 50px rgba(0,0,0,.2);
      transition: transform .35s ease, border-color .35s ease;
    }
    .card:hover { transform: translateY(-6px); border-color: rgba(168,195,173,.44); }
    .card h3 { margin: 0 0 6px; font-size: 18px; }
    .quality-card { min-height: 178px; padding: 25px 27px; }
    .quality-number { display: block; margin-bottom: 18px; color: var(--accent2); font-size: 12px; font-weight: 800; letter-spacing: .12em; }
    .quality-card h3 { margin-bottom: 9px; }
    .quality-card p { max-width: 38ch; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.68; }
    .item { padding: 19px 0; border-top: 1px solid var(--line); }
    .item:first-of-type { border-top: 0; }
    .item-title { margin-bottom: 7px; font-size: 16px; font-weight: 750; line-height: 1.35; }
    .item p { max-width: 58ch; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.68; }
    .skill { margin: 18px 0; }
    .skill-top { display: flex; justify-content: space-between; gap: 16px; margin-bottom: 8px; font-size: 14px; }
    .skill-top span:last-child { color: var(--accent); }
    .bar { height: 7px; overflow: hidden; border-radius: 999px; background: rgba(255,255,255,.07); }
    .fill {
      position: relative;
      width: 0;
      height: 100%;
      overflow: hidden;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      box-shadow: 0 0 14px rgba(168,195,173,.28);
      transition: width 1.75s cubic-bezier(.16, 1, .3, 1);
    }
    .fill::after {
      position: absolute;
      top: 0;
      left: -42%;
      width: 26%;
      height: 100%;
      content: "";
      opacity: 0;
      transform: skewX(-24deg);
      background: rgba(255,255,255,.78);
    }
    .reveal.visible .fill::after { animation: fill-sheen 1.4s ease-out .65s both; }
    .creative-section { margin-top: 26px; padding-top: 23px; border-top: 1px solid var(--line); }
    .creative-section h3 { margin-bottom: 4px; }
    .creative-list { display: grid; gap: 0; }
    .creative-item { padding: 17px 0; border-top: 1px solid var(--line); }
    .creative-item:first-child { border-top: 0; }
    .creative-item h4 { margin: 1px 0 5px; font-size: 16px; }
    .creative-item p { max-width: 42ch; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.62; }
    .contact { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .contact a {
      display: grid; gap: 7px; min-width: 0; padding: 21px; border: 1px solid var(--line); border-radius: 18px;
      background: rgba(255,255,255,.045); color: var(--text); overflow-wrap: anywhere; text-decoration: none; transition: .25s;
    }
    .contact a:hover { border-color: rgba(168,195,173,.44); transform: translateY(-3px); }
    .contact small { color: var(--accent); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
    footer { padding: 30px 24px 42px; color: var(--muted); font-size: 13px; text-align: center; }
    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .75s ease, transform .75s ease; }
    .reveal.visible { opacity: 1; transform: none; }
    @keyframes pulse { 50% { transform: scale(1.45); opacity: .55; } }
    @keyframes blink { 50% { opacity: 0; } }
    @keyframes fill-sheen { 0% { left: -42%; opacity: 0; } 15% { opacity: .7; } 100% { left: 120%; opacity: 0; } }
    @media (min-width: 1400px) { .wrap { width: min(1080px, calc(100% - 96px)); } section { padding: 74px 0; } }
    @media (max-width: 760px) {
      nav { justify-content: flex-start; overflow-x: auto; scrollbar-width: none; }
      nav::-webkit-scrollbar { display: none; }
      nav a { flex: 0 0 auto; padding-inline: 12px; }
      .wrap { width: min(100% - 32px, 620px); }
      .hero { min-height: 100svh; padding: 116px 0 64px; }
      .role { flex-wrap: wrap; gap: 0 .32em; }
      .typing-wrap { min-width: 23ch; }
      .grid, .qualities-grid, .contact { grid-template-columns: 1fr; }
      .section-head { gap: 12px; }
      section { padding: 48px 0; }
      .card { padding: 23px; }
    }
    @media (max-width: 430px) {
      .eyebrow { font-size: 10px; letter-spacing: .11em; }
      .role { font-size: 18px; }
      .role-static { width: 100%; }
      .typing-wrap { min-width: 22ch; justify-content: center; }
      .intro { font-size: 16px; }
    }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important; } }
    @media print { nav, .actions { display: none; } body { background: #fff; color: #111; } .hero { min-height: auto; padding: 40px 0 15px; } .card, .contact a { box-shadow: none; background: #fff; border-color: #ccc; } .reveal { opacity: 1; transform: none; } .fill { width: var(--print-width, 0) !important; } }
  </style>
</head>
<body>
  <nav aria-label="Navigare principală">
    <a href="#despre">Despre</a><a href="#calitati">Calități</a><a href="#competente">Competențe</a><a href="#experienta">Experiență</a><a href="#contact">Contact</a>
  </nav>
  <header class="hero" id="despre">
    <div class="wrap hero-inner reveal">
      <div class="eyebrow"><span class="dot"></span>Disponibil pentru oportunități</div>
      <h1>CÎRDEI DAVID-ANDREI</h1>
      <p class="role"><span class="role-static">Organizat · Motivat ·</span><span class="typing-wrap"><span class="typed" id="typed" aria-live="polite"></span><span class="cursor" aria-hidden="true"></span></span></p>
      <p class="intro">Am 21 de ani și caut un loc de muncă stabil și de lungă durată, în program de 8h, 6h sau 4h. Sunt de asemenea deschis la colaborări pe proiecte scurte sau freelancing.</p>
